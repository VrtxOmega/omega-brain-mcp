        "review",
        "scout",
        "audit",
        "coordination",
        "mcp-verify",
        "docs-polish"
      ],
      "defaultSlices": [
        "second-eyes review",
        "gap analysis",
        "MCP doctor verification",
        "cross-repo read"
      ],
      "notDefaultOwnerOf": [
        "implementation commits unless write scope is explicitly split"
