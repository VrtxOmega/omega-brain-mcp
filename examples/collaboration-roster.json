  "doctrine": {
    "operatorMeaning": "Watchers deliver messages; active agent sessions decide, act, reply, and credit useful input.",
    "sessionStart": [
      "Check omega_agents or /api/agents when available.",
      "Drain the current agent inbox before state-changing work.",
      "Read this roster before inviting collaborators."
    ],
    "collaborationTriggers": [
      "blocker: cannot proceed safely without another agent or human input",
      "opportunity: another agent's strength would improve quality before commit, deployment, or public action",
      "integration: acknowledge useful input and state what was accepted, revised, or deferred"
    ],
    "messageShape": [
      "topic",
      "objective",
      "my-slice",
      "invite",
      "boundaries",
      "artifact",
      "credit"
    ],
    "hardBoundaries": [
      "No public GitHub writes without explicit user approval.",
      "No silent overlap on another agent's declared write scope.",
      "State ACCEPT, REVISE, or DEFER when reviewing another agent's slice.",
      "Credit useful input in replies and closeouts."
    ]
  },
  "agents": {
